{
  "name": "@curtain/broadcaster",
  "version": "0.0.1",
  "private": true,
  "description": "Waku-style relay listener: validates bundles, pays gas, submits, publishes fee schedule",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
