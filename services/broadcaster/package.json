    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "14",
    "@chainsafe/libp2p-noise": "16",
    "@chainsafe/libp2p-yamux": "7",
    "@libp2p/identify": "3",
    "@libp2p/interface": "2",
    "@libp2p/tcp": "10",
    "@multiformats/multiaddr": "12",
    "libp2p": "2.8.14",
    "viem": "^2.57.0"
  }
