{
  "name": "@curtain/indexer",
  "version": "0.0.1",
  "private": true,
  "description": "Indexes on-chain Curtain events into Postgres for api/status",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/main.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@electric-sql/pglite": "^0.3.0"
  },
  "dependencies": {
    "@curtain/db": "workspace:*",
    "viem": "^2.57.0"
  }
}
