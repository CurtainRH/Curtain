# ── Chain ─────────────────────────────────────────────────────────────
CHAIN_ID=4663
# Public endpoint is rate limited with no SLA; use a dedicated provider for the operator.
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com

# ── Contracts (from contracts/deployments/<chainid>.json) ───────────────
VAULT_ADDR=
STAKING_ADDR=
# Uniswap v3 on Robinhood Chain (developers.uniswap.org): SwapRouter02 + QuoterV2
DEX_ROUTER_ADDR=0xcaf681a66d020601342297493863e78c959e5cb2
# JSON symbol -> address, e.g. {"USDG":"0x...","NVDA":"0x..."}
TOKENS={}

# ── Operator ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/curtain
OPERATOR_PRIVATE_KEY=
ROUTE=uniswap
UNISWAP_QUOTER_ADDR=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
# Uniswap v4: adapter from the deployment + V4Quoter. Leave V4_ADAPTER_ADDR empty for v3 only.
V4_ADAPTER_ADDR=
V4_QUOTER_ADDR=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
SLIPPAGE_BPS=50
KEEPER_FEE_BPS=5
OPERATOR_PORT=3100
TICK_MS=5000

# ── Keeper (anyone can run one) ─────────────────────────────────────────
KEEPER_PRIVATE_KEY=
OPERATOR_API=http://localhost:3100

# ── Deploy (contracts/script/Deploy.s.sol on 4663) ──────────────────────
PRIVATE_KEY=
ADMIN_ADDR=
OPERATOR_ADDR=
TREASURY_ADDR=
# Uniswap v4 PoolManager on Robinhood Chain: deploys + allowlists UniswapV4Adapter
V4_POOL_MANAGER_ADDR=0x8366a39cc670b4001a1121b8f6a443a643e40951
# Comma-separated tokens to allow. Robinhood Chain mainnet (verified 2026-10-01 against
# docs.robinhood.com/chain/contracts and api.robinhood.com/rhj/assets):
#   USDG 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168  NVDA 0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
#   TSLA 0x322F0929c4625eD5bAd873c95208D54E1c003b2d  SPY  0x117cc2133c37B721F49dE2A7a74833232B3B4C0C
#   QQQ  0xD5f3879160bc7c32ebb4dC785F8a4F505888de68  (no HOOD stock token exists on Robinhood Chain)
TOKEN_ADDRS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168,0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC,0x322F0929c4625eD5bAd873c95208D54E1c003b2d,0x117cc2133c37B721F49dE2A7a74833232B3B4C0C,0xD5f3879160bc7c32ebb4dC785F8a4F505888de68
