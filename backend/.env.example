# ── Chain ─────────────────────────────────────────────────────────────
CHAIN_ID=4663
RPC_HTTP=
RPC_WS=

# ── Contract addresses (filled in by contracts/script/Pin.s.sol after deploy) ──
POOL_ADDR=
GATE_ADDR=
ADAPT_ADDR=
BOND_ADDR=
STEALTH_REG_ADDR=
STEALTH_ANN_ADDR=
DISCLOSURE_ADDR=
SOLVENCY_ADDR=
ASSET_GATE_ADDR=
CRTN_ADDR=
STAKING_ADDR=

# ── External protocol addresses ─────────────────────────────────────────
USDG_ADDR=
UNIV3_ROUTER_ADDR=
UNIV4_POOL_MANAGER_ADDR=
MORPHO_USDG_VAULT_ADDR=
ARCUS_ROUTER_ADDR=
PRISM_DEX_ROUTER_ADDR=

# ── PPOI ────────────────────────────────────────────────────────────────
# JSON array: [{"id":1,"url":"...","pubkey":"..."}, ...] — at least 3 providers
PPOI_PROVIDERS=[]
STANDBY_SECONDS=900
STANDBY_DEGRADED_SECONDS=3600

# ── Fees ────────────────────────────────────────────────────────────────
FEE_BPS_SHIELD=20
FEE_BPS_UNSHIELD=20
BROADCASTER_MIN_BOND=25000000000000000000000
BROADCASTER_MAX_FEE_BPS=30

# ── Data layer (Railway-hosted) ──────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/curtain
REDIS_URL=redis://localhost:6379

# ── Proving ─────────────────────────────────────────────────────────────
PROVER_MODE=local
PROVER_ASSIST_URL=
PROVER_ASSIST_ATTESTATION_ROOT=

# ── Services ────────────────────────────────────────────────────────────
API_PORT=3000
STATUS_PORT=3001
BROADCASTER_PORT=3002
NODE_ENV=development
