{
  "name": "curtain",
  "private": true,
  "version": "0.0.1",
  "description": "Curtain ($CRTN) — privacy system for Robinhood Chain",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --path-ignore-patterns '**/contracts/lib/**'",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "bun run --filter='*' lint",
    "build": "bun run --filter='*' build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
