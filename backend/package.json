{
  "name": "curtain",
  "private": true,
  "version": "0.0.1",
  "description": "Curtain ($CRTN) — privacy system for Robinhood Chain",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --path-ignore-patterns '**/contracts/lib/**'",
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "bun run --filter='*' lint",
    "build": "bun run --filter='*' build",
    "test:unit": "bun test --path-ignore-patterns '**/contracts/lib/**' --path-ignore-patterns '**/*.e2e.test.ts'",
    "check": "bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3",
    "viem": "^2.57.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
